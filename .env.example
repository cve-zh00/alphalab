# Alpaca — credenciales de SOLO LECTURA para datos de mercado.
# Copia este archivo a .env (que esta gitignoreado) y rellena tus claves.
# Obtenlas en https://app.alpaca.markets/paper/dashboard/overview -> "API Keys".
#
# Basta una cuenta PAPER: leer assets y barras no requiere cuenta live.
ALPHALAB_ALPACA_KEY_ID=
ALPHALAB_ALPACA_SECRET_KEY=

# paper (default) | live. El sistema NO coloca ordenes: no hay codigo que lo haga.
# Dejar en paper. Ver alpaca_config.py para por que live esta doblemente bloqueado.
ALPHALAB_ALPACA_ENDPOINT=paper

# Opcional. El plan gratuito permite 200/min; 150 deja margen.
ALPHALAB_ALPACA_RATE_LIMIT_PER_MINUTE=150

# EDGAR exige identificarse con un User-Agent real.
ALPHALAB_EDGAR_USER_AGENT=tu-nombre tu@email.com
